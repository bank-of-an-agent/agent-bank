{
  "name": "@agentbank/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Agent Bank: a typed client for the REST API, session keys and RFC 9421 request signing, owner authorizations, an x402 paying fetch, x402 seller middleware, private proofs (agent proving and a seller proof gate) and webhook verification.",
  "keywords": [
    "agent-bank",
    "ai-agents",
    "x402",
    "usdc",
    "payments",
    "base",
    "rfc9421",
    "eip-3009",
    "zero-knowledge",
    "groth16"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bank-of-an-agent/agent-bank.git",
    "directory": "packages/sdk-ts"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./x402-server": "./src/x402-server.ts",
    "./proof-server": "./src/proof-server.ts",
    "./prover": "./src/prover.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./node": {
        "import": {
          "types": "./dist/node.d.ts",
          "default": "./dist/node.js"
        },
        "require": {
          "types": "./dist/node.d.cts",
          "default": "./dist/node.cjs"
        }
      },
      "./x402-server": {
        "import": {
          "types": "./dist/x402-server.d.ts",
          "default": "./dist/x402-server.js"
        },
        "require": {
          "types": "./dist/x402-server.d.cts",
          "default": "./dist/x402-server.cjs"
        }
      },
      "./proof-server": {
        "import": {
          "types": "./dist/proof-server.d.ts",
          "default": "./dist/proof-server.js"
        },
        "require": {
          "types": "./dist/proof-server.d.cts",
          "default": "./dist/proof-server.cjs"
        }
      },
      "./prover": {
        "import": {
          "types": "./dist/prover.d.ts",
          "default": "./dist/prover.js"
        },
        "require": {
          "types": "./dist/prover.d.cts",
          "default": "./dist/prover.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsup",
    "smoke:dist": "tsx scripts/smoke-dist.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.6",
    "viem": "^2.57.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@agentbank/core": "workspace:*",
    "@agentbank/proofs": "workspace:*",
    "@types/express": "^5.0.6",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/express": "2.28.0",
    "@x402/hono": "2.28.0",
    "express": "^5.3.0",
    "fastify": "^5.12.5",
    "hono": "^4.13.13",
    "tsup": "^8.5.1"
  }
}
