# Copy to .env for local development. Never commit real secrets.
# All values below are LOCAL/TESTNET defaults only.
DATABASE_URL=postgres://agentbank:agentbank@127.0.0.1:54329/agentbank
AGENTBANK_CHAIN=simulated            # simulated | base-sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
PIMLICO_API_KEY=                      # from your secret manager (testnet)
COSIGNER_URL=http://127.0.0.1:8081
COSIGNER_SHARED_SECRET=dev-only-shared-secret-change-me
COSIGNER_SIGNER=local                 # local (testnet/dev only) | kms
COSIGNER_KMS_KEY_ID=
ALLOW_OPEN_SIGNUP=true
FEATURE_PRIVATE_PROOFS=true
# Private-proof root attester on anvil/base-sepolia (a testnet key of its own, never the relayer
# key); the simulated chain uses its built-in public attester.
PROOFS_ATTESTER_KEY=
