{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".vitepress/dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": [
        "DATABASE_URL",
        "RUN_LIVE_TESTS",
        "BASE_SEPOLIA_RPC_URL",
        "RUN_FORK_TESTS",
        "ANVIL_RPC_URL",
        "BUNDLER_URL",
        "ANVIL_CMD",
        "ALTO_CMD",
        "FORGE_CMD",
        "CONTRACTS_DIR",
        "SESSION_MODULES"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "env": [
        "DATABASE_URL",
        "RUN_LIVE_TESTS",
        "BASE_SEPOLIA_RPC_URL",
        "RUN_FORK_TESTS",
        "ANVIL_RPC_URL",
        "BUNDLER_URL",
        "ANVIL_CMD",
        "ALTO_CMD",
        "FORGE_CMD",
        "CONTRACTS_DIR",
        "SESSION_MODULES"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  },
  "agentGuidance": false
}
